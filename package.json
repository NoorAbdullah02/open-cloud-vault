{
  "name": "noor-drive",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@noor-drive/api",
    "dev:web": "npm run dev --workspace=@noor-drive/web",
    "build": "npm run build --workspace=@noor-drive/api && npm run build --workspace=@noor-drive/web",
    "start": "node scripts/start-combined.js",
    "db:push": "npm run prisma:push --workspace=@noor-drive/api",
    "db:seed": "npm run seed --workspace=@noor-drive/api",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
