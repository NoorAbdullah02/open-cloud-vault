# ==========================================
# NOOR DRIVE - ENVIRONMENT CONFIGURATION
# ==========================================

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Backend API Server
API_PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Authentication & Passcode
DRIVE_PASSCODE="change-me"
SUPER_ADMIN_EMAIL="sheikhnoorabdullah02@gmail.com"
ADMIN_NOTIFY_EMAIL="sheikhnoorabdullah02@gmail.com"
BREVO_API_KEY="your-brevo-api-key"
SUPER_ADMIN_PASSWORD="change-me"
SUPER_ADMIN_NAME="Noor Owner"
JWT_ACCESS_SECRET="generate-64-char-random-hex"
JWT_REFRESH_SECRET="generate-64-char-random-hex"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Telegram MTProto Storage (from https://my.telegram.org & node scripts/telegram-auth.js)
DEFAULT_STORAGE_PROVIDER="TELEGRAM_MTPROTO"
TELEGRAM_ENABLED="true"
TELEGRAM_USER_CONSENT="true"
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_SESSION_STRING=""
TELEGRAM_TARGET_CHANNEL="me"

# Frontend Web App
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
