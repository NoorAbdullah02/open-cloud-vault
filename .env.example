# ==========================================
# NOOR DRIVE - ENVIRONMENT CONFIGURATION
# ==========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://macmini@localhost:5432/noor_drive?schema=public"

# Redis (Cache, Queues, Realtime)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Backend API Server
API_PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

# Authentication & Security
JWT_ACCESS_SECRET="change-this-to-a-64-char-random-hex-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-another-64-char-random-hex-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Super Admin Bootstrap (Personal Owner)
SUPER_ADMIN_EMAIL="admin@noordrive.local"
SUPER_ADMIN_PASSWORD="change-me-strong-passcode"
DRIVE_PASSCODE="change-me"
SUPER_ADMIN_NAME="Noor Owner"

# Storage Engine Configuration
# Options: LOCAL_DISK | TELEGRAM_MTPROTO | S3_COMPATIBLE
DEFAULT_STORAGE_PROVIDER="LOCAL_DISK"
LOCAL_STORAGE_PATH="./storage/vault"
CHUNK_STORAGE_PATH="./storage/chunks"
MAX_FILE_SIZE_BYTES=2147483648 # 2 GB default limit

# Telegram MTProto Storage Adapter (Requires Explicit User Consent)
# Obtain API_ID and API_HASH from https://my.telegram.org
TELEGRAM_ENABLED="false"
TELEGRAM_USER_CONSENT="false"
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_SESSION_STRING=""
TELEGRAM_TARGET_CHANNEL="me"

# S3-Compatible Storage Adapter (Optional: Cloudflare R2, MinIO, AWS S3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Frontend Web App
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

